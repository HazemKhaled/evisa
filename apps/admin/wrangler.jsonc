{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gtv-admin",
  "account_id": "4f001bbb358404250b26da276402b564",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "minify": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
    "issues": {
      "enabled": true
    }
  },
  "placement": {
    "mode": "smart",
  },
  "preview_urls": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "admin.gettravelvisa.com",
      "custom_domain": true,
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "gtv-admin",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "gtv-admin-cache",
    },
  ],
  "d1_databases": [
    // Next tag cache (Next mode).
    // This is the same database the website worker uses at
    // `apps/website/wrangler.jsonc`; sharing it is what lets a publish here
    // invalidate the public site's ISR entries. Required by the
    // `revalidatePath` calls in `src/actions`.
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "ee88ce2e-ccd0-4322-ad0d-5aad6446693f",
      "database_name": "gtv-opennext-cache",
    },
  ],
  // "images": {
  //   "binding": "IMAGES",
  // },

  /**
   * Workers Previews (`wrangler preview`) never inherit the top-level config, so
   * every binding the Worker reads from `env` has to be repeated here against a
   * Preview-safe resource. Pointing these at the production cache would let a
   * branch Preview write into the live ISR/R2/D1 cache. The D1 database is
   * shared with the website's Preview so cross-worker invalidation still works
   * between the two Preview workers.
   */
  "previews": {
    "d1_databases": [
      {
        "binding": "NEXT_TAG_CACHE_D1",
        "database_name": "gtv-opennext-cache-preview",
        "database_id": "27f97493-ed99-4b66-8cb8-22d7ba72098b",
      },
    ],
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "gtv-admin-cache-preview",
      },
    ],
  },
}
